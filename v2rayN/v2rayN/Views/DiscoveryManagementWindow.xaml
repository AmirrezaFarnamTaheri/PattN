<base:WindowBase
    x:Class="v2rayN.Views.DiscoveryManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.menuDiscoveryManagement}"
    Width="1240"
    Height="820"
    MinWidth="920"
    MinHeight="640"
    x:TypeArguments="vms:DiscoveryManagementViewModel"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock
                Margin="{StaticResource Margin8}"
                Style="{StaticResource ToolbarTextBlock}"
                Text="{x:Static resx:ResUI.TbDiscoveryManagementDesc}"
                TextWrapping="Wrap" />
            <ToolBarTray>
                <ToolBar HorizontalAlignment="Center" Style="{StaticResource MaterialDesignToolBar}">
                    <Button AutomationProperties.Name="{x:Static resx:ResUI.TbRefreshAll}" MinHeight="44" x:Name="btnRefreshAll">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="{StaticResource MarginRight8}" Kind="Refresh" />
                            <TextBlock Text="{x:Static resx:ResUI.TbRefreshAll}" />
                        </StackPanel>
                    </Button>
                    <Separator />
                    <Button AutomationProperties.Name="{x:Static resx:ResUI.menuClose}" MinHeight="44" x:Name="btnClose" IsCancel="True">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Margin="{StaticResource MarginRight8}" Kind="Close" />
                            <TextBlock Text="{x:Static resx:ResUI.menuClose}" />
                        </StackPanel>
                    </Button>
                </ToolBar>
            </ToolBarTray>
        </StackPanel>

        <Border
            DockPanel.Dock="Bottom"
            Margin="{StaticResource Margin8}"
            Padding="{StaticResource Margin8}"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    Text="{x:Static resx:ResUI.TbDiscoveryStatus}" />
                <TextBlock
                    x:Name="txtStatus"
                    Grid.Column="1"
                    Margin="{StaticResource MarginLeft8}"
                    AutomationProperties.Name="{x:Static resx:ResUI.TbDiscoveryStatus}"
                    AutomationProperties.LiveSetting="Polite"
                    TextWrapping="Wrap" />
                <ProgressBar
                    x:Name="busyProgress"
                    Grid.Column="2"
                    Height="4"
                    Margin="{StaticResource MarginLeft8}"
                    VerticalAlignment="Center"
                    IsIndeterminate="True"
                    Visibility="Collapsed"
                    AutomationProperties.Name="{x:Static resx:ResUI.TbDiscoveryStatus}" />
            </Grid>
        </Border>

        <TabControl x:Name="mainTabs" AutomationProperties.Name="{x:Static resx:ResUI.menuDiscoveryManagement}">
            <TabItem Header="{x:Static resx:ResUI.TbProviderCatalogs}">
                <DockPanel Margin="{StaticResource Margin8}">
                    <ToolBarTray DockPanel.Dock="Top">
                        <ToolBar Style="{StaticResource MaterialDesignToolBar}">
                            <Button MinHeight="44" x:Name="btnRegisterCatalog" Content="{x:Static resx:ResUI.TbRegisterCatalog}" AutomationProperties.Name="{x:Static resx:ResUI.TbRegisterCatalog}" />
                            <Button MinHeight="44" x:Name="btnRefreshCatalog" Content="{x:Static resx:ResUI.TbRefreshAudit}" AutomationProperties.Name="{x:Static resx:ResUI.TbRefreshAudit}" />
                            <Button MinHeight="44" x:Name="btnToggleCatalog" Content="{x:Static resx:ResUI.TbToggleEnabled}" AutomationProperties.Name="{x:Static resx:ResUI.TbToggleEnabled}" />
                            <Button MinHeight="44" x:Name="btnUnregisterCatalog" Content="{x:Static resx:ResUI.TbUnregisterCatalog}" AutomationProperties.Name="{x:Static resx:ResUI.TbUnregisterCatalog}" />
                            <Separator />
                            <Button MinHeight="44" x:Name="btnPreviewCatalogUpdate" Content="{x:Static resx:ResUI.TbPreviewCatalogUpdate}" AutomationProperties.Name="{x:Static resx:ResUI.TbPreviewCatalogUpdate}" />
                            <Button MinHeight="44" x:Name="btnApplyCatalogUpdate" Content="{x:Static resx:ResUI.TbApplyCatalogUpdate}" AutomationProperties.Name="{x:Static resx:ResUI.TbApplyCatalogUpdate}" />
                            <Button MinHeight="44" x:Name="btnRollbackRevision" Content="{x:Static resx:ResUI.TbRollbackRevision}" AutomationProperties.Name="{x:Static resx:ResUI.TbRollbackRevision}" />
                        </ToolBar>
                    </ToolBarTray>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.15*" />
                        </Grid.RowDefinitions>

                        <DataGrid
                            x:Name="lstCatalogs"
                            AutomationProperties.Name="{x:Static resx:ResUI.TbProviderCatalogs}"
                            Grid.Row="0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            Style="{StaticResource DefDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="1.3*" Binding="{Binding DisplayName}" Header="{x:Static resx:ResUI.LvRemarks}" />
                                <DataGridTextColumn Width="1.2*" Binding="{Binding CatalogId}" Header="{x:Static resx:ResUI.LvCatalogId}" />
                                <DataGridTextColumn Width="100" Binding="{Binding CatalogVersion}" Header="{x:Static resx:ResUI.LvVersion}" />
                                <DataGridCheckBoxColumn Width="80" Binding="{Binding Enabled}" Header="{x:Static resx:ResUI.LvEnabled}" />
                                <DataGridTextColumn Width="160" Binding="{Binding LastAuditedAt}" Header="{x:Static resx:ResUI.LvLastAudit}" />
                                <DataGridTextColumn Width="1.3*" Binding="{Binding FilePath}" Header="{x:Static resx:ResUI.LvFile}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="1" Margin="{StaticResource Margin8}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="{StaticResource Margin8}" VerticalAlignment="Center" Text="{x:Static resx:ResUI.TbDisplayName}" />
                            <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbDisplayName}" x:Name="txtCatalogDisplayName" Grid.Row="0" Grid.Column="1" Margin="{StaticResource Margin8}" Style="{StaticResource DefTextBox}" />
                            <Button MinHeight="44" x:Name="btnRenameCatalog" Grid.Row="0" Grid.Column="2" Margin="{StaticResource Margin8}" Content="{x:Static resx:ResUI.TbRelabel}" AutomationProperties.Name="{x:Static resx:ResUI.TbRelabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="{StaticResource Margin8}" VerticalAlignment="Top" Text="{x:Static resx:ResUI.TbAuditSummary}" />
                            <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbAuditSummary}" x:Name="txtCatalogAudit" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" MinHeight="55" Margin="{StaticResource Margin8}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"  />
                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="{StaticResource Margin8}" VerticalAlignment="Top" Text="{x:Static resx:ResUI.TbUpdatePreview}" />
                            <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbUpdatePreview}" x:Name="txtCatalogUpdatePreview" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" MinHeight="55" Margin="{StaticResource Margin8}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"  />
                        </Grid>

                        <Expander
                            Grid.Row="2"
                            Margin="{StaticResource Margin8}"
                            Header="{x:Static resx:ResUI.TbRemoteCatalogSource}"
                            IsExpanded="False">
                            <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock
                                    Margin="{StaticResource Margin8}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbRemoteCatalogSourceDesc}"
                                    TextWrapping="Wrap" />

                                <Grid Margin="{StaticResource Margin8}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="{StaticResource Margin8}" VerticalAlignment="Center" Text="{x:Static resx:ResUI.TbRemoteCatalogUri}" />
                                    <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteCatalogUri}" x:Name="txtRemoteCatalogUri" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="{StaticResource Margin8}" Style="{StaticResource DefTextBox}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="{StaticResource Margin8}" VerticalAlignment="Center" Text="{x:Static resx:ResUI.TbRemoteSignatureUri}" />
                                    <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteSignatureUri}" x:Name="txtRemoteSignatureUri" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="{StaticResource Margin8}" Style="{StaticResource DefTextBox}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="{StaticResource Margin8}" VerticalAlignment="Center" Text="{x:Static resx:ResUI.TbRemoteSignaturePolicy}" />
                                    <ComboBox MinHeight="44" AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteSignaturePolicy}" x:Name="cmbRemoteSignaturePolicy" Grid.Row="2" Grid.Column="1" Margin="{StaticResource Margin8}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="{StaticResource Margin8}" VerticalAlignment="Center" Text="{x:Static resx:ResUI.TbRemoteTrustedKeyId}" />
                                    <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteTrustedKeyId}" x:Name="txtRemoteTrustedKeyId" Grid.Row="2" Grid.Column="3" Margin="{StaticResource Margin8}" Style="{StaticResource DefTextBox}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="{StaticResource Margin8}" VerticalAlignment="Top" Text="{x:Static resx:ResUI.TbRemoteTrustedPublicKey}" />
                                    <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteTrustedPublicKey}"
                                        x:Name="txtRemoteTrustedPublicKey"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="3"
                                        MinHeight="52"
                                        Margin="{StaticResource Margin8}"
                                        AcceptsReturn="True"
                                        Style="{StaticResource DefTextBox}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </Grid>

                                <GroupBox Margin="{StaticResource Margin8}" Header="{x:Static resx:ResUI.TbRemoteTlsPins}">
                                    <StackPanel Margin="{StaticResource Margin8}">
                                        <TextBlock
                                            Margin="{StaticResource Margin8}"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbRemoteTlsPinsDesc}"
                                            TextWrapping="Wrap" />
                                        <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteTlsPins}"
                                            x:Name="txtRemoteTlsSpkiPins"
                                            MinHeight="68"
                                            Margin="{StaticResource Margin8}"
                                            AcceptsReturn="True"
                                            Style="{StaticResource DefTextBox}"
                                            TextWrapping="NoWrap"
                                            VerticalScrollBarVisibility="Auto" />
                                        <TextBlock
                                            x:Name="txtRemoteTlsPinStatus"
                                AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteTlsPins}" AutomationProperties.LiveSetting="Polite"
                                            Margin="{StaticResource Margin8}"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Margin="{StaticResource Margin8}" Orientation="Horizontal">
                                            <Button MinHeight="44" x:Name="btnInspectRemoteTlsSpki" Margin="{StaticResource MarginRight8}" Content="{x:Static resx:ResUI.TbInspectServerSpki}" AutomationProperties.Name="{x:Static resx:ResUI.TbInspectServerSpki}" />
                                            <Button MinHeight="44" x:Name="btnAddObservedRemoteTlsPin" Content="{x:Static resx:ResUI.TbAddObservedSpkiPin}" AutomationProperties.Name="{x:Static resx:ResUI.TbAddObservedSpkiPin}" />
                                        </StackPanel>
                                        <TextBlock Margin="{StaticResource Margin8}" Text="{x:Static resx:ResUI.TbObservedServerSpki}" />
                                        <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbObservedServerSpki}"
                                            x:Name="txtRemoteObservedTlsSpki"
                                            Margin="{StaticResource Margin8}"
                                            IsReadOnly="True"
                                            Style="{StaticResource DefTextBox}"  />
                                        <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbObservedServerSpki}"
                                            x:Name="txtRemoteObservedTlsDetails"
                                            MinHeight="58"
                                            Margin="{StaticResource Margin8}"
                                            IsReadOnly="True"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto"  />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Margin="{StaticResource Margin8}" Header="{x:Static resx:ResUI.TbRemoteTrustPortability}">
                                    <StackPanel Margin="{StaticResource Margin8}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button MinHeight="44" x:Name="btnExportRemoteSourceConfig" Margin="{StaticResource MarginRight8}" Content="{x:Static resx:ResUI.TbExportRemoteSourceTrust}" AutomationProperties.Name="{x:Static resx:ResUI.TbExportRemoteSourceTrust}" />
                                            <Button MinHeight="44" x:Name="btnPreviewRemoteSourceImport" Margin="{StaticResource MarginRight8}" Content="{x:Static resx:ResUI.TbPreviewRemoteSourceImport}" AutomationProperties.Name="{x:Static resx:ResUI.TbPreviewRemoteSourceImport}" />
                                            <Button MinHeight="44" x:Name="btnApplyRemoteSourceImport" Content="{x:Static resx:ResUI.TbApplyRemoteSourceImport}" AutomationProperties.Name="{x:Static resx:ResUI.TbApplyRemoteSourceImport}" />
                                        </StackPanel>
                                        <TextBlock Margin="{StaticResource Margin8}" Text="{x:Static resx:ResUI.TbRemoteSourceImportPreview}" />
                                        <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteSourceImportPreview}"
                                            x:Name="txtRemoteSourceImportPreview"
                                            MinHeight="58"
                                            Margin="{StaticResource Margin8}"
                                            IsReadOnly="True"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto"  />
                                    </StackPanel>
                                </GroupBox>

                                <StackPanel Margin="{StaticResource Margin8}" Orientation="Horizontal">
                                    <Button MinHeight="44" x:Name="btnSaveRemoteSource" Margin="{StaticResource MarginRight8}" Content="{x:Static resx:ResUI.TbSaveRemoteSource}" AutomationProperties.Name="{x:Static resx:ResUI.TbSaveRemoteSource}" />
                                    <Button MinHeight="44" x:Name="btnRemoveRemoteSource" Margin="{StaticResource MarginRight8}" Content="{x:Static resx:ResUI.TbRemoveRemoteSource}" AutomationProperties.Name="{x:Static resx:ResUI.TbRemoveRemoteSource}" />
                                    <Button MinHeight="44" x:Name="btnFetchRemotePreview" Margin="{StaticResource MarginRight8}" Content="{x:Static resx:ResUI.TbFetchRemotePreview}" AutomationProperties.Name="{x:Static resx:ResUI.TbFetchRemotePreview}" />
                                    <Button MinHeight="44" x:Name="btnApplyRemotePreview" Content="{x:Static resx:ResUI.TbApplyRemotePreview}" AutomationProperties.Name="{x:Static resx:ResUI.TbApplyRemotePreview}" />
                                </StackPanel>

                                <Grid Margin="{StaticResource Margin8}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="{StaticResource Margin8}" VerticalAlignment="Top" Text="{x:Static resx:ResUI.TbRemoteSourceStatus}" />
                                    <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteSourceStatus}" x:Name="txtRemoteSourceStatus" Grid.Row="0" Grid.Column="1" MinHeight="48" Margin="{StaticResource Margin8}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"  />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="{StaticResource Margin8}" VerticalAlignment="Top" Text="{x:Static resx:ResUI.TbRemoteFetchPreview}" />
                                    <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteFetchPreview}" x:Name="txtRemoteFetchPreview" Grid.Row="1" Grid.Column="1" MinHeight="64" Margin="{StaticResource Margin8}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"  />
                                </Grid>
                            </StackPanel>
                            </ScrollViewer>
                        </Expander>

                        <GroupBox Grid.Row="3" Header="{x:Static resx:ResUI.TbRevisions}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DataGrid
                                    x:Name="lstCatalogRevisions"
                                    AutomationProperties.Name="{x:Static resx:ResUI.TbRevisions}"
                                    Grid.Row="0"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    IsReadOnly="True"
                                    Style="{StaticResource DefDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="170" Binding="{Binding AppliedAt}" Header="{x:Static resx:ResUI.LvTime}" />
                                        <DataGridTextColumn Width="*" Binding="{Binding BeforeCatalogVersion}" Header="{x:Static resx:ResUI.LvBefore}" />
                                        <DataGridTextColumn Width="*" Binding="{Binding AfterCatalogVersion}" Header="{x:Static resx:ResUI.LvAfter}" />
                                        <DataGridCheckBoxColumn Width="80" Binding="{Binding Active}" Header="{x:Static resx:ResUI.LvActive}" />
                                        <DataGridTextColumn Width="170" Binding="{Binding RolledBackAt}" Header="{x:Static resx:ResUI.LvRolledBack}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbRevisions}"
                                    x:Name="txtCatalogRevisionDetails"
                                    Grid.Row="1"
                                    MinHeight="72"
                                    Margin="{StaticResource Margin8}"
                                    IsReadOnly="True"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto"  />
                            </Grid>
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="{x:Static resx:ResUI.TbRemoteSources}">
                <DockPanel Margin="{StaticResource Margin8}">
                    <TextBlock
                        DockPanel.Dock="Top"
                        Margin="{StaticResource Margin8}"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbRemoteSourcesDesc}"
                        TextWrapping="Wrap" />
                    <TabControl>
                        <TabItem Header="{x:Static resx:ResUI.LvStatus}">
                            <DockPanel>
                                <ToolBarTray DockPanel.Dock="Top">
                                    <ToolBar Style="{StaticResource MaterialDesignToolBar}">
                                        <Button MinHeight="44" x:Name="btnRefreshRemoteSourceHealth" Content="{x:Static resx:ResUI.TbRefreshAll}" AutomationProperties.Name="{x:Static resx:ResUI.TbRefreshAll}" />
                                    </ToolBar>
                                </ToolBarTray>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="txtRemoteSourceHealthSummary"
                                        AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteSources}" AutomationProperties.LiveSetting="Polite" Grid.Row="0" Margin="{StaticResource Margin8}" Style="{StaticResource ToolbarTextBlock}" TextWrapping="Wrap" />
                                    <DataGrid
                                        x:Name="lstRemoteSourceHealth"
                                        AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteSources}"
                                        Grid.Row="1"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        IsReadOnly="True"
                                        Style="{StaticResource DefDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="1.15*" Binding="{Binding DisplayName}" Header="{x:Static resx:ResUI.LvRemarks}" />
                                            <DataGridTextColumn Width="100" Binding="{Binding CatalogVersion}" Header="{x:Static resx:ResUI.LvVersion}" />
                                            <DataGridCheckBoxColumn Width="80" Binding="{Binding Configured}" Header="{x:Static resx:ResUI.LvConfigured}" />
                                            <DataGridTextColumn Width="1.5*" Binding="{Binding SourceUri}" Header="{x:Static resx:ResUI.LvHttpsSource}" />
                                            <DataGridTextColumn Width="100" Binding="{Binding SignaturePolicy}" Header="{x:Static resx:ResUI.LvSignature}" />
                                            <DataGridTextColumn Width="165" Binding="{Binding LastCheckedAt}" Header="{x:Static resx:ResUI.LvLastCheck}" />
                                            <DataGridTextColumn Width="110" Binding="{Binding HealthClass}" Header="{x:Static resx:ResUI.LvStatus}" />
                                            <DataGridCheckBoxColumn Width="95" Binding="{Binding NeedsReview}" Header="{x:Static resx:ResUI.TbNeedsReview}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <GroupBox Grid.Row="2" Header="{x:Static resx:ResUI.TbRemoteSourceHealthDetails}">
                                        <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteSourceHealthDetails}" x:Name="txtRemoteSourceHealthDetails" MinHeight="90" Margin="{StaticResource Margin8}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"  />
                                    </GroupBox>
                                </Grid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="{x:Static resx:ResUI.TbRemoteProvenance}">
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Top"
                                    Margin="{StaticResource Margin8}"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbRemoteProvenanceDesc}"
                                    TextWrapping="Wrap" />
                                <Grid DockPanel.Dock="Top" Margin="{StaticResource Margin8}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Margin="{StaticResource Margin8}" VerticalAlignment="Center" Text="{x:Static resx:ResUI.TbSourceHostFilter}" />
                                    <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbSourceHostFilter}" x:Name="txtRemoteProvenanceSourceHost" Grid.Column="1" Margin="{StaticResource Margin8}" Style="{StaticResource DefTextBox}" />
                                    <TextBlock Grid.Column="2" Margin="{StaticResource Margin8}" VerticalAlignment="Center" Text="{x:Static resx:ResUI.TbRemoteTrustedKeyId}" />
                                    <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteTrustedKeyId}" x:Name="txtRemoteProvenanceTrustedKey" Grid.Column="3" Margin="{StaticResource Margin8}" Style="{StaticResource DefTextBox}" />
                                    <TextBlock Grid.Column="4" Margin="{StaticResource Margin8}" VerticalAlignment="Center" Text="{x:Static resx:ResUI.TbTlsSpkiPinFilter}" />
                                    <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbTlsSpkiPinFilter}" x:Name="txtRemoteProvenanceTlsPin" Grid.Column="5" Margin="{StaticResource Margin8}" Style="{StaticResource DefTextBox}" />
                                    <Button MinHeight="44" x:Name="btnSearchRemoteProvenance" Grid.Column="6" Margin="{StaticResource Margin8}" Content="{x:Static resx:ResUI.TbSearchProvenance}" AutomationProperties.Name="{x:Static resx:ResUI.TbSearchProvenance}" />
                                </Grid>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="txtRemoteProvenanceSummary"
                                        AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteProvenance}" AutomationProperties.LiveSetting="Polite" Grid.Row="0" Margin="{StaticResource Margin8}" Style="{StaticResource ToolbarTextBlock}" TextWrapping="Wrap" />
                                    <DataGrid
                                        x:Name="lstRemoteProvenance"
                                        AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteProvenance}"
                                        Grid.Row="1"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        IsReadOnly="True"
                                        Style="{StaticResource DefDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="1.1*" Binding="{Binding RevisionId}" Header="{x:Static resx:ResUI.LvRevision}" />
                                            <DataGridTextColumn Width="1.5*" Binding="{Binding SourceUri}" Header="{x:Static resx:ResUI.LvSource}" />
                                            <DataGridTextColumn Width="1*" Binding="{Binding TrustedKeyId}" Header="{x:Static resx:ResUI.LvTrustedKey}" />
                                            <DataGridTextColumn Width="1*" Binding="{Binding SignatureValidation.Status}" Header="{x:Static resx:ResUI.LvSignature}" />
                                            <DataGridTextColumn Width="170" Binding="{Binding AppliedAt}" Header="{x:Static resx:ResUI.LvTime}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <GroupBox Grid.Row="2" Header="{x:Static resx:ResUI.TbRemoteProvenance}">
                                        <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbRemoteProvenance}" x:Name="txtRemoteProvenanceDetails" MinHeight="90" Margin="{StaticResource Margin8}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"  />
                                    </GroupBox>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>

            <TabItem Header="{x:Static resx:ResUI.TbRetiredCatalogs}">
                <DockPanel Margin="{StaticResource Margin8}">
                    <ToolBarTray DockPanel.Dock="Top">
                        <ToolBar Style="{StaticResource MaterialDesignToolBar}">
                            <Button MinHeight="44" x:Name="btnRefreshRetiredCatalogs" Content="{x:Static resx:ResUI.TbRefreshRetiredCatalogs}" AutomationProperties.Name="{x:Static resx:ResUI.TbRefreshRetiredCatalogs}" />
                            <Button MinHeight="44" x:Name="btnReRegisterRetiredCatalog" Content="{x:Static resx:ResUI.TbReRegisterCatalog}" AutomationProperties.Name="{x:Static resx:ResUI.TbReRegisterCatalog}" />
                            <Button MinHeight="44" x:Name="btnExportRetiredArchive" Content="{x:Static resx:ResUI.TbExportRetiredArchive}" AutomationProperties.Name="{x:Static resx:ResUI.TbExportRetiredArchive}" />
                            <Button MinHeight="44" x:Name="btnInspectCatalogArchive" Content="{x:Static resx:ResUI.TbInspectCatalogArchive}" AutomationProperties.Name="{x:Static resx:ResUI.TbInspectCatalogArchive}" />
                            <Separator />
                            <Button MinHeight="44" x:Name="btnDiscardRetiredHistory" Content="{x:Static resx:ResUI.TbDiscardRetiredHistory}" AutomationProperties.Name="{x:Static resx:ResUI.TbDiscardRetiredHistory}" />
                        </ToolBar>
                    </ToolBarTray>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.3*" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid
                            x:Name="lstRetiredCatalogs"
                            AutomationProperties.Name="{x:Static resx:ResUI.TbRetiredCatalogs}"
                            Grid.Row="0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            Style="{StaticResource DefDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="1.2*" Binding="{Binding DisplayName}" Header="{x:Static resx:ResUI.LvRemarks}" />
                                <DataGridTextColumn Width="1.1*" Binding="{Binding CatalogId}" Header="{x:Static resx:ResUI.LvCatalogId}" />
                                <DataGridTextColumn Width="100" Binding="{Binding CatalogVersion}" Header="{x:Static resx:ResUI.LvVersion}" />
                                <DataGridTextColumn Width="170" Binding="{Binding UnregisteredAt}" Header="{x:Static resx:ResUI.LvRetired}" />
                                <DataGridTextColumn Width="1.5*" Binding="{Binding FilePath}" Header="{x:Static resx:ResUI.LvFile}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid AutomationProperties.Name="{x:Static resx:ResUI.TbRevisions}"
                            x:Name="lstRetiredCatalogRevisions"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            Style="{StaticResource DefDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="170" Binding="{Binding AppliedAt}" Header="{x:Static resx:ResUI.LvTime}" />
                                <DataGridTextColumn Width="*" Binding="{Binding BeforeCatalogVersion}" Header="{x:Static resx:ResUI.LvBefore}" />
                                <DataGridTextColumn Width="*" Binding="{Binding AfterCatalogVersion}" Header="{x:Static resx:ResUI.LvAfter}" />
                                <DataGridTextColumn Width="170" Binding="{Binding RolledBackAt}" Header="{x:Static resx:ResUI.LvRolledBack}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GroupBox Grid.Row="2" Header="{x:Static resx:ResUI.TbRetiredCatalogDetails}">
                            <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbRetiredCatalogDetails}"
                                x:Name="txtRetiredCatalogDetails"
                                MinHeight="90"
                                Margin="{StaticResource Margin8}"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"  />
                        </GroupBox>
                        <GroupBox Grid.Row="3" Header="{x:Static resx:ResUI.TbArchiveInspection}">
                            <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbArchiveInspection}"
                                x:Name="txtArchiveInspectionSummary"
                                MinHeight="80"
                                Margin="{StaticResource Margin8}"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"  />
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="{x:Static resx:ResUI.TbEndpointPool}">
                <DockPanel Margin="{StaticResource Margin8}">
                    <ToolBarTray DockPanel.Dock="Top">
                        <ToolBar Style="{StaticResource MaterialDesignToolBar}">
                            <Button MinHeight="44" x:Name="btnRefreshEndpoints" Content="{x:Static resx:ResUI.TbDNSHealthRefresh}" AutomationProperties.Name="{x:Static resx:ResUI.TbDNSHealthRefresh}" />
                            <Button MinHeight="44" x:Name="btnToggleEndpointPinned" Content="{x:Static resx:ResUI.TbPinUnpin}" AutomationProperties.Name="{x:Static resx:ResUI.TbPinUnpin}" />
                            <Button MinHeight="44" x:Name="btnToggleEndpointEnabled" Content="{x:Static resx:ResUI.TbToggleEnabled}" AutomationProperties.Name="{x:Static resx:ResUI.TbToggleEnabled}" />
                        </ToolBar>
                    </ToolBarTray>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid
                            x:Name="lstEndpoints"
                            AutomationProperties.Name="{x:Static resx:ResUI.TbEndpointPool}"
                            Grid.Row="0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            Style="{StaticResource DefDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="1.1*" Binding="{Binding Label}" Header="{x:Static resx:ResUI.LvRemarks}" />
                                <DataGridTextColumn Width="1.1*" Binding="{Binding LogicalHost}" Header="{x:Static resx:ResUI.LvTlsServerName}" />
                                <DataGridTextColumn Width="1.1*" Binding="{Binding HttpHost}" Header="{x:Static resx:ResUI.LvHttpHost}" />
                                <DataGridTextColumn Width="1.1*" Binding="{Binding Address}" Header="{x:Static resx:ResUI.LvAddress}" />
                                <DataGridTextColumn Width="70" Binding="{Binding Port}" Header="{x:Static resx:ResUI.LvPort}" />
                                <DataGridCheckBoxColumn Width="70" Binding="{Binding Enabled}" Header="{x:Static resx:ResUI.LvEnabled}" />
                                <DataGridCheckBoxColumn Width="60" Binding="{Binding Pinned}" Header="{x:Static resx:ResUI.LvPinned}" />
                                <DataGridTextColumn Width="95" Binding="{Binding CurrentObservationState}" Header="{x:Static resx:ResUI.LvStatus}" />
                                <DataGridCheckBoxColumn Width="105" Binding="{Binding HistoricallyGood}" Header="{x:Static resx:ResUI.LvHistorical}" />
                                <DataGridTextColumn Width="*" Binding="{Binding Provider}" Header="{x:Static resx:ResUI.LvProvider}" />
                                <DataGridTextColumn Width="100" Binding="{Binding Asn}" Header="{x:Static resx:ResUI.LvAsn}" />
                                <DataGridTextColumn Width="90" Binding="{Binding Pop}" Header="{x:Static resx:ResUI.LvPop}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Margin="{StaticResource Margin8}" Orientation="Horizontal">
                            <TextBlock Margin="{StaticResource Margin8}" VerticalAlignment="Center" Text="{x:Static resx:ResUI.TbDisplayName}" />
                            <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbDisplayName}" x:Name="txtEndpointLabel" Width="360" Margin="{StaticResource Margin8}" Style="{StaticResource DefTextBox}" />
                            <Button MinHeight="44" x:Name="btnRelabelEndpoint" Margin="{StaticResource Margin8}" Content="{x:Static resx:ResUI.TbRelabel}" AutomationProperties.Name="{x:Static resx:ResUI.TbRelabel}" />
                        </StackPanel>
                        <GroupBox Grid.Row="2" Header="{x:Static resx:ResUI.TbEndpointHistory}">
                            <Grid Margin="{StaticResource Margin8}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbEndpointHistory}" x:Name="txtEndpointHistory" Grid.Row="0" MinHeight="70" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"  />
                                <DataGrid
                                    x:Name="lstEndpointTimeline"
                                    AutomationProperties.Name="{x:Static resx:ResUI.TbEndpointHistory}"
                                    Grid.Row="1"
                                    MinHeight="150"
                                    Margin="0,8,0,0"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    IsReadOnly="True"
                                    Style="{StaticResource DefDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="165" Binding="{Binding ObservedAt}" Header="{x:Static resx:ResUI.LvTime}" />
                                        <DataGridCheckBoxColumn Width="85" Binding="{Binding Qualified}" Header="{x:Static resx:ResUI.LvQualified}" />
                                        <DataGridTextColumn Width="90" Binding="{Binding Reliability, StringFormat=P0}" Header="{x:Static resx:ResUI.LvReliability}" />
                                        <DataGridTextColumn Width="100" Binding="{Binding MedianLatencyMs}" Header="{x:Static resx:ResUI.LvLatencyMs}" />
                                        <DataGridTextColumn Width="90" Binding="{Binding Successes}" Header="{x:Static resx:ResUI.LvSuccesses}" />
                                        <DataGridTextColumn Width="*" Binding="{Binding Source}" Header="{x:Static resx:ResUI.LvSource}" />
                                        <DataGridTextColumn Width="100" Binding="{Binding Asn}" Header="{x:Static resx:ResUI.LvAsn}" />
                                        <DataGridTextColumn Width="90" Binding="{Binding Pop}" Header="{x:Static resx:ResUI.LvPop}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="{x:Static resx:ResUI.TbRepairHistory}">
                <DockPanel Margin="{StaticResource Margin8}">
                    <ToolBarTray DockPanel.Dock="Top">
                        <ToolBar Style="{StaticResource MaterialDesignToolBar}">
                            <Button MinHeight="44" x:Name="btnRefreshRepairHistory" Content="{x:Static resx:ResUI.TbDNSHealthRefresh}" AutomationProperties.Name="{x:Static resx:ResUI.TbDNSHealthRefresh}" />
                        </ToolBar>
                    </ToolBarTray>
                    <TextBlock x:Name="txtRepairHistorySummary"
                                AutomationProperties.Name="{x:Static resx:ResUI.TbRepairHistory}" AutomationProperties.LiveSetting="Polite" DockPanel.Dock="Top" Margin="{StaticResource Margin8}" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid
                            x:Name="lstRepairHistory"
                            AutomationProperties.Name="{x:Static resx:ResUI.TbRepairHistory}"
                            Grid.Row="0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            Style="{StaticResource DefDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="100" Binding="{Binding EventKind}" Header="{x:Static resx:ResUI.LvType}" />
                                <DataGridTextColumn Width="170" Binding="{Binding ObservedAt}" Header="{x:Static resx:ResUI.LvTime}" />
                                <DataGridTextColumn Width="*" Binding="{Binding OriginalProfileId}" Header="{x:Static resx:ResUI.LvOriginalProfile}" />
                                <DataGridTextColumn Width="*" Binding="{Binding PromotedProfileId}" Header="{x:Static resx:ResUI.LvPromotedProfile}" />
                                <DataGridTextColumn Width="80" Binding="{Binding Score}" Header="{x:Static resx:ResUI.LvScore}" />
                                <DataGridTextColumn Width="100" Binding="{Binding OutcomeVerdict}" Header="{x:Static resx:ResUI.LvStatus}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbRepairHistory}" x:Name="txtRepairEventDetails" Grid.Row="1" MinHeight="85" Margin="{StaticResource Margin8}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"  />
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="{x:Static resx:ResUI.TbDiscoveryMaintenance}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{StaticResource Margin8}">
                        <GroupBox Header="{x:Static resx:ResUI.TbEndpointPoolCleanup}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <StackPanel Orientation="Horizontal">
                                    <Button MinHeight="44" x:Name="btnPreviewEndpointMaintenance" Margin="{StaticResource Margin4}" Content="{x:Static resx:ResUI.TbPreviewEndpointCleanup}" AutomationProperties.Name="{x:Static resx:ResUI.TbPreviewEndpointCleanup}" />
                                    <Button MinHeight="44" x:Name="btnApplyEndpointMaintenance" Margin="{StaticResource Margin4}" Content="{x:Static resx:ResUI.TbApplyEndpointCleanup}" AutomationProperties.Name="{x:Static resx:ResUI.TbApplyEndpointCleanup}" />
                                </StackPanel>
                                <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbPreviewEndpointCleanup}" x:Name="txtEndpointMaintenancePreview" MinHeight="130" Margin="{StaticResource Margin4}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"  />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Margin="0,12,0,0" Header="{x:Static resx:ResUI.TbDatabaseCompaction}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <StackPanel Orientation="Horizontal">
                                    <Button MinHeight="44" x:Name="btnPreviewDatabaseCompaction" Margin="{StaticResource Margin4}" Content="{x:Static resx:ResUI.TbPreviewDatabaseCompaction}" AutomationProperties.Name="{x:Static resx:ResUI.TbPreviewDatabaseCompaction}" />
                                    <Button MinHeight="44" x:Name="btnApplyDatabaseCompaction" Margin="{StaticResource Margin4}" Content="{x:Static resx:ResUI.TbApplyDatabaseCompaction}" AutomationProperties.Name="{x:Static resx:ResUI.TbApplyDatabaseCompaction}" />
                                </StackPanel>
                                <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbPreviewDatabaseCompaction}" x:Name="txtDatabaseCompactionPreview" MinHeight="110" Margin="{StaticResource Margin4}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"  />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Margin="0,12,0,0" Header="{x:Static resx:ResUI.TbLifecycleEvidenceRetention}">
                            <StackPanel Margin="{StaticResource Margin8}">
                                <StackPanel Orientation="Horizontal">
                                    <Button MinHeight="44" x:Name="btnPreviewRetention" Margin="{StaticResource Margin4}" Content="{x:Static resx:ResUI.TbPreviewLifecycleRetention}" AutomationProperties.Name="{x:Static resx:ResUI.TbPreviewLifecycleRetention}" />
                                    <Button MinHeight="44" x:Name="btnApplyRetention" Margin="{StaticResource Margin4}" Content="{x:Static resx:ResUI.TbApplyLifecycleRetention}" AutomationProperties.Name="{x:Static resx:ResUI.TbApplyLifecycleRetention}" />
                                </StackPanel>
                                <TextBox AutomationProperties.Name="{x:Static resx:ResUI.TbPreviewLifecycleRetention}" x:Name="txtRetentionPreview" MinHeight="130" Margin="{StaticResource Margin4}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"  />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</base:WindowBase>
